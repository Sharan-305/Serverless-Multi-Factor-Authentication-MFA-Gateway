# Environment Configuration for Serverless MFA Gateway

# Serverless Stage & Region
STAGE=dev
AWS_REGION=us-east-1

# MongoDB Atlas Connection
MONGODB_URI=mongodb+srv://<username>:<password>@cluster0.mongodb.net/?retryWrites=true&w=majority
DB_NAME=mfa_gateway

# JWT Security
JWT_SECRET=super-secret-mfa-gateway-jwt-key-change-this-in-production-32chars!
JWT_ALGORITHM=HS256
JWT_EXPIRATION_MINUTES=60

# OTP Configuration
OTP_EXPIRY_MINUTES=5
MAX_OTP_ATTEMPTS=3
# Options for OTP_PROVIDER: mock | smtp | ses | sns | auto
OTP_PROVIDER=mock

# Rate Limiting
RATE_LIMIT_LOGIN_PER_MIN=5
RATE_LIMIT_OTP_PER_MIN=3

# Standard SMTP Email Dispatch (Set OTP_PROVIDER=smtp to send real emails to recipient mail IDs)
# Gmail Setup Example:
#   SMTP_HOST=smtp.gmail.com
#   SMTP_PORT=587
#   SMTP_USERNAME=your_gmail_address@gmail.com
#   SMTP_PASSWORD=your_16_char_app_password
#   SMTP_SENDER_EMAIL=your_gmail_address@gmail.com
#   SMTP_USE_TLS=true
#   SMTP_USE_SSL=false
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USERNAME=
SMTP_PASSWORD=
SMTP_SENDER_EMAIL=noreply@example.com
SMTP_USE_TLS=true
SMTP_USE_SSL=false

# AWS Communications (Optional if OTP_PROVIDER is mock or smtp)
SES_SENDER_EMAIL=noreply@example.com
